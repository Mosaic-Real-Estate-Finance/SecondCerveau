<?xml version="1.0" encoding="UTF-8"?>
<!--
  Add-in only manifest (the XML one), chosen over the unified manifest because
  it is the form classic Outlook on Windows supports.

  NestedAppAuth is deliberately not declared here: that requirement set cannot
  be declared in an Outlook add-in manifest and is tested at runtime instead,
  in src/outlook/office.ts. See specs/001-outlook-vers-notion/research.md B-2.

  Replace HOST with the deployment domain before sideloading. Every URL must be
  https, and AppDomains must list every origin the taskpane navigates to.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>3cb13804-89bb-40d2-90a9-259435f827e4</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Mosaic Real Estate Finance</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Vers Notion" />
  <Description DefaultValue="Classe un échange Outlook dans la base de notes Notion de Mosaic, rattaché aux bons contacts." />
  <IconUrl DefaultValue="https://HOST/outlook/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://HOST/outlook/icon-128.png" />
  <SupportUrl DefaultValue="https://HOST/outlook/" />

  <AppDomains>
    <AppDomain>https://HOST</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.5">
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <!-- Required by the schema, and superseded by the VersionOverrides below. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://HOST/outlook.html" />
        <RequestedHeight>400</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="taskpaneUrl" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="mosaicGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="mosaicToNotion">
                  <Label resid="buttonLabel" />
                  <Supertip>
                    <Title resid="buttonLabel" />
                    <Description resid="buttonTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                    <!-- The panel stays open across mails; office.ts listens to ItemChanged. -->
                    <SupportsPinning>true</SupportsPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://HOST/outlook/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://HOST/outlook/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://HOST/outlook/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://HOST/outlook.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Mosaic" />
        <bt:String id="buttonLabel" DefaultValue="Vers Notion" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonTip" DefaultValue="Rattache cet échange à un contact et l'enregistre dans la base de notes Notion." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
