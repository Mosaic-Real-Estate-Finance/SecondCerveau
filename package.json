{
  "name": "mosaic-dictee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "predev:mobile": "node scripts/copy-ort.mjs",
    "dev:mobile": "vite --host --mode mobile",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/outlook-manifest.mjs --out dist/outlook/manifest.xml",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "splash": "node scripts/generate-ios-splash.mjs",
    "typecheck": "tsc -b",
    "check:api": "node scripts/check-api.mjs",
    "check:readai": "node scripts/check-readai-schema.mjs",
    "test:readai": "node scripts/test-readai.mjs",
    "test:outlook": "node scripts/test-outlook.mjs",
    "sim:readai": "node scripts/simulate-readai.mjs",
    "avatars": "node scripts/generate-avatars.mjs",
    "dev:outlook": "node scripts/outlook-manifest.mjs localhost:5173 && vite --host --mode outlook --port 5173 --strictPort",
    "outlook:manifest": "node scripts/outlook-manifest.mjs",
    "outlook:icons": "node scripts/generate-outlook-icons.mjs",
    "outlook:certs": "office-addin-dev-certs install --days 365 --domains 127.0.0.1,localhost,192.168.1.86",
    "dev:vercel": "vercel dev --listen 5173",
    "outlook:manifest:prod": "node scripts/outlook-manifest.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.24.0",
    "@fontsource/lora": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.9",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "motion": "^13.4.4",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "voice-glow": "^0.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "office-addin-dev-certs": "^3.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
