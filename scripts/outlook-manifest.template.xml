<?xml version="1.0" encoding="UTF-8"?>
<!--
  Add-in only manifest (the XML one), chosen over the unified manifest because
  it is the form classic Outlook on Windows supports.

  NestedAppAuth is deliberately not declared here: that requirement set cannot
  be declared in an Outlook add-in manifest and is tested at runtime instead,
  in src/outlook/office.ts. See specs/001-outlook-vers-notion/research.md B-2.

  This file is the template, not the served manifest: the deployment domain is
  a placeholder here, and it lives outside public/ so it is never published
  as-is. scripts/outlook-manifest.mjs writes the real one.

  Any change here must raise <Version>. Outlook only redistributes an already
  installed add-in when the version is higher, so a manifest change that keeps
  the number reaches nobody. The generator refuses to run otherwise.

  Every URL must be https, and AppDomains must list every origin the taskpane
  navigates to.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>3cb13804-89bb-40d2-90a9-259435f827e4</Id>
  <Version>1.4.0.0</Version>
  <ProviderName>Mosaic Real Estate Finance</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Save to Notion" />
  <Description DefaultValue="Classe un échange Outlook dans la base de notes Notion de Mosaic, rattaché aux bons contacts." />
  <IconUrl DefaultValue="https://{{HOST}}/outlook/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://{{HOST}}/outlook/icon-128.png" />
  <!-- Must resolve: the taskpane itself, rather than a /outlook/ index that
       only exists because the dev server falls back to one. -->
  <SupportUrl DefaultValue="https://{{HOST}}/outlook.html" />

  <AppDomains>
    <AppDomain>https://{{HOST}}</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.5">
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <!-- Required by the schema, and superseded by the VersionOverrides below. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://{{HOST}}/outlook.html" />
        <RequestedHeight>400</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <!--
    Two nested VersionOverrides, and the nesting is not decoration.

    SupportsPinning only exists in the 1.1 schema, and the 1.1 block has to sit
    inside the 1.0 one so that a host which only understands 1.0 still gets a
    working button. The two blocks therefore describe the same control twice,
    the inner one adding pinning.
  -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Required by the schema. Deliberately a page that does nothing:
               this add-in has no ExecuteFunction action, and pointing this at
               the taskpane would run the whole panel in a hidden runtime. -->
          <FunctionFile resid="commandsUrl" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="mosaicGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="mosaicToNotion">
                  <Label resid="buttonLabel" />
                  <Supertip>
                    <Title resid="buttonLabel" />
                    <Description resid="buttonTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://{{HOST}}/outlook/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://{{HOST}}/outlook/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://{{HOST}}/outlook/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://{{HOST}}/outlook.html" />
        <bt:Url id="commandsUrl" DefaultValue="https://{{HOST}}/outlook/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Mosaic" />
        <bt:String id="buttonLabel" DefaultValue="Save to Notion" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonTip" DefaultValue="Enregistre ce fil dans la base de notes Notion et le rattache aux contacts externes qui y participent." />
      </bt:LongStrings>
    </Resources>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <!-- Required by the schema. Deliberately a page that does nothing:
                 this add-in has no ExecuteFunction action, and pointing this at
                 the taskpane would run the whole panel in a hidden runtime. -->
            <FunctionFile resid="commandsUrl" />

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mosaicGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="mosaicToNotion">
                    <Label resid="buttonLabel" />
                    <Supertip>
                      <Title resid="buttonLabel" />
                      <Description resid="buttonTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl" />
                      <!-- Keeps the panel open when the user selects another mail. -->
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>

          <!-- Outlook on iOS and Android (feature 003). Only in this 1.1
               block: MobileFormFactor does not exist in the 1.0 schema. The
               same taskpane, full screen; no Supertip and no pinning on a
               phone, so neither is declared. Sign-in there relies on nested
               app authentication, which Microsoft ships on both apps from
               build 4.2433.0 (research 003 A-1). -->
          <MobileFormFactor>
            <FunctionFile resid="commandsUrl" />
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="mosaicMobileGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="MobileButton" id="mosaicToNotionMobile">
                  <Label resid="buttonLabel" />
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="mobile25x1" />
                    <bt:Image size="25" scale="2" resid="mobile25x2" />
                    <bt:Image size="25" scale="3" resid="mobile25x3" />
                    <bt:Image size="32" scale="1" resid="mobile32x1" />
                    <bt:Image size="32" scale="2" resid="mobile32x2" />
                    <bt:Image size="32" scale="3" resid="mobile32x3" />
                    <bt:Image size="48" scale="1" resid="mobile48x1" />
                    <bt:Image size="48" scale="2" resid="mobile48x2" />
                    <bt:Image size="48" scale="3" resid="mobile48x3" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://{{HOST}}/outlook/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://{{HOST}}/outlook/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://{{HOST}}/outlook/icon-80.png" />
        <!-- Outlook on iOS and Android: three sizes, each at scales 1, 2 and 3. -->
        <bt:Image id="mobile25x1" DefaultValue="https://{{HOST}}/outlook/icon-25.png" />
        <bt:Image id="mobile25x2" DefaultValue="https://{{HOST}}/outlook/icon-25@2x.png" />
        <bt:Image id="mobile25x3" DefaultValue="https://{{HOST}}/outlook/icon-25@3x.png" />
        <bt:Image id="mobile32x1" DefaultValue="https://{{HOST}}/outlook/icon-32.png" />
        <bt:Image id="mobile32x2" DefaultValue="https://{{HOST}}/outlook/icon-32@2x.png" />
        <bt:Image id="mobile32x3" DefaultValue="https://{{HOST}}/outlook/icon-32@3x.png" />
        <bt:Image id="mobile48x1" DefaultValue="https://{{HOST}}/outlook/icon-48.png" />
        <bt:Image id="mobile48x2" DefaultValue="https://{{HOST}}/outlook/icon-48@2x.png" />
        <bt:Image id="mobile48x3" DefaultValue="https://{{HOST}}/outlook/icon-48@3x.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://{{HOST}}/outlook.html" />
        <bt:Url id="commandsUrl" DefaultValue="https://{{HOST}}/outlook/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="Mosaic" />
        <bt:String id="buttonLabel" DefaultValue="Save to Notion" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonTip" DefaultValue="Enregistre ce fil dans la base de notes Notion et le rattache aux contacts externes qui y participent." />
      </bt:LongStrings>
    </Resources>
    </VersionOverrides>
  </VersionOverrides>

</OfficeApp>
