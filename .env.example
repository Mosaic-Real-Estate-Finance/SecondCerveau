# Copie de référence des variables d'environnement. Aucune valeur secrète ici.
#
# En développement : copier en .env.local et compléter.
# En production : les mêmes clés dans l'hébergeur, NOTION_TOKEN en secret.

# --- Notion -----------------------------------------------------------------

# Intégration Notion (Paramètres → Connexions → Développer ses intégrations).
# SECRET. Ne doit jamais atteindre le navigateur : il ne vit que côté serveur.
# L'intégration doit être partagée avec les deux bases.
NOTION_TOKEN=ntn_xxx

# Identifiants des bases, tels qu'ils apparaissent dans l'URL Notion.
NOTION_CONTACTS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_NOTES_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Noms de colonnes, à ajuster si elles sont renommées dans Notion --------

# Base Contacts.
# Attention : « Nom société » ne désigne aucune colonne du schéma actuel ; le
# code tombe alors sur une requête de résolution des noms (specs/001-outlook-
# vers-notion/research.md A-3).
CONTACTS_PROP_COMPANY_ROLLUP=Nom société
CONTACTS_PROP_COMPANY_RELATION=Société
CONTACTS_PROP_ROLE=Fonction
CONTACTS_PROP_TYPE=Type
# Vide : tri sur la date de création native de la page.
CONTACTS_PROP_CREATED=
# Colonne email, qui sert à reconnaître les participants d'un fil de mails.
# Plusieurs adresses y tiennent, séparées par des virgules.
CONTACTS_PROP_EMAIL=Email

# Base Notes.
# Vide : la relation de la base Notes qui pointe vers Contacts est trouvée par
# son type (ici « Interlocuteur »).
NOTES_PROP_CONTACT=
NOTES_PROP_DATE=Date
NOTES_PROP_TRANSCRIPT=Transcription brute
NOTES_PROP_AUTHOR=Auteur
NOTES_PROP_FILE=Fichiers
# Rend l'envoi idempotent en cas de réessai. Dictée : l'identifiant de la note.
# Outlook : l'identifiant de la conversation. Vide = aucune protection contre
# les doublons.
NOTES_PROP_CLIENT_ID=ID client
# Origine de la note : « Dictée » ou « Email ».
NOTES_PROP_SOURCE=Source
# Identifiant Graph du dernier message de mail intégré à la note.
NOTES_PROP_LAST_MESSAGE=Dernier message
# Déclencheur de la réécriture par Notion AI : « À traiter » ou « Traité ».
NOTES_PROP_AI_STATUS=Statut IA

# --- Complément Outlook -----------------------------------------------------

# Domaines internes : leurs adresses ne sont jamais rattachées à une note.
INTERNAL_DOMAINS=mosaicfin.com

# --- Client -----------------------------------------------------------------

# Modèle de transcription, chargé et exécuté sur l'appareil.
VITE_WHISPER_MODEL=onnx-community/whisper-small-cv11-french-ONNX

# --- Application Microsoft Entra -------------------------------------------
# Identifiants publics, pas des secrets : le client ID est l'audience attendue
# des jetons, et il est de toute façon visible dans le bundle du taskpane.
ENTRA_TENANT_IDS=
ENTRA_API_CLIENT_ID=

# Les mêmes, côté taskpane. Vite n'expose au navigateur que ce qui commence
# par VITE_, donc elles sont redéclarées plutôt que devinées.
VITE_ENTRA_CLIENT_ID=
# « common » laisse l'hôte Outlook choisir le locataire de l'utilisateur ;
# c'est la liste blanche côté serveur qui décide lesquels sont acceptés.
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common
VITE_ENTRA_API_SCOPE=api://<client-id>/access_as_user
